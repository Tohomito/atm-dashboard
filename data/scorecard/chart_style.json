{
 "c-bullet-news": {
  "type": "bullet",
  "rows": {
   "Open rate": {
    "max": 60,
    "fmt": "percent",
    "marks": {
     "Omeda B2B median": "B2B median",
     "beehiiv platform avg 2025": "beehiiv avg"
    }
   },
   "Click rate per delivered (verified)": {
    "max": 2.5,
    "fmt": "percent",
    "marks": {
     "Omeda B2B median": "B2B median",
     "Omeda all-publisher top of range": "top of range"
    }
   },
   "Click-to-open (verified)": {
    "max": 9,
    "fmt": "percent",
    "marks": {
     "Omeda B2B median": "B2B",
     "GlueLetter bot-filtered median": "bot-filtered median"
    }
   },
   "Unsubscribe rate per issue": {
    "max": 0.6,
    "fmt": "percent",
    "marks": {
     "Omeda B2B median": "B2B",
     "MailerLite all-industry": "all-industry",
     "\"content mismatch\" line": "mismatch"
    }
   },
   "Delivery rate": {
    "max": 100,
    "fmt": "percent",
    "marks": {
     "beehiiv platform": "platform"
    }
   }
  },
  "opts": {
   "labW": 200,
   "aria": "Newsletter metrics vs benchmarks"
  }
 },
 "c-bullet-social": {
  "type": "bullet",
  "rows": {
   "Instagram Reel engagement rate": {
    "max": 1.2,
    "fmt": "percent",
    "marks": {
     "Rival IQ all-industry median": "all-ind.",
     "Rival IQ Media median": "Media median",
     "Rival IQ top quartile": "top quartile"
    }
   },
   "Instagram follower growth, annualized": {
    "max": 30,
    "fmt": "percent",
    "marks": {
     "Socialinsider 5–10K tier, 2025": "tier par"
    }
   },
   "YouTube organic views / month": {
    "max": 12000,
    "fmt": "integer",
    "marks": {
     "Digiday (views ÷ uploads × ~30 uploads/mo, derived)": "Digiday ≈"
    }
   },
   "LinkedIn page engagement rate": {
    "max": 16,
    "fmt": "percent",
    "marks": {
     "Socialinsider 2026 average": "platform avg",
     "video posts avg": "video",
     "documents avg": "documents"
    }
   }
  },
  "opts": {
   "labW": 200,
   "aria": "Social metrics vs benchmarks"
  }
 },
 "c-acq": {
  "type": "stack100",
  "colors": {
   "List imports": "--s1",
   "Site embed form": "--s2",
   "Other (magic link, web)": "--s3"
  },
  "opts": {
   "aria": "Subscriber acquisition sources"
  }
 },
 "c-openers": {
  "type": "vbar",
  "opts": {
   "fmt": "integer_abbrev",
   "aria": "Monthly unique openers"
  }
 },
 "c-issues": {
  "type": "line",
  "colors": {
   "Open rate": "--s1"
  },
  "opts": {
   "fmt": "pct0",
   "max": 70,
   "every": 2,
   "band": [
    6,
    12
   ],
   "bandLabel": "list doubled",
   "aria": "Open rate by issue",
   "h": 170
  }
 },
 "c-issues2": {
  "type": "line",
  "colors": {
   "Verified click-to-open": "--s2"
  },
  "opts": {
   "fmt": "pct1",
   "max": 3.5,
   "every": 2,
   "band": [
    6,
    12
   ],
   "bandLabel": "list doubled",
   "aria": "Click-to-open by issue",
   "h": 150
  }
 },
 "c-bots": {
  "type": "hbar",
  "colors": {
   "Scanner clicks (32 accounts)": "--muted",
   "Human clicks (93 people)": "--s1"
  },
  "opts": {
   "fmt": "integer",
   "labW": 200,
   "rowH": 38,
   "aria": "Bot vs human clicks"
  }
 },
 "c-unsub": {
  "type": "vbar",
  "opts": {
   "fmt": "percent",
   "max": 0.62,
   "hideVals": true,
   "every": 2,
   "aria": "Unsubscribe rate by issue",
   "marks": [
    {
     "label": "Omeda B2B median 0.088%",
     "value": 0.088
    },
    {
     "label": "0.5% mismatch line",
     "value": 0.5,
     "dash": true
    }
   ],
   "colors": {
    "Jul 17": "--s1",
    "Jul 22": "--s1",
    "Jul 24": "--s1",
    "Jul 31": "--s1",
    "Aug 7": "--s1",
    "Aug 14": "--s1",
    "Aug 21": "--s1",
    "Aug 28": "--s1",
    "Sep 1": "--crit",
    "Sep 4": "--s1",
    "Sep 11": "--crit",
    "Sep 15": "--s1",
    "Sep 18": "--crit"
   }
  }
 },
 "c-links": {
  "type": "hbar",
  "colors": {
